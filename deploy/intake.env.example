# Credentials for the intake service, the scout and the notifier.
#
# Names only -- every value here is a placeholder. The real file lives at
# ~/talent-engine-runtime/intake.env, mode 0600, and is never committed.
# Nothing in this repository reads a secret from anywhere else.

# --- intake -----------------------------------------------------------------
# Tally signs each webhook with this; an unsigned or wrongly signed POST is
# rejected before it is parsed.
TALLY_SIGNING_SECRET=
TALLY_FORM_ID=

# --- scoring ----------------------------------------------------------------
# A GitHub token raises the rate limit from 60/hour to 5000/hour. Read-only
# public data: no scopes are needed beyond the default.
GITHUB_TOKEN=

# --- notification -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_FROM_NAME=

# --- the three read surfaces ------------------------------------------------
# Each is a random path segment, and each IS the access control: a spreadsheet
# pulls these anonymously, so there is no session to authenticate. Generate
# with `python3 -c "import secrets; print(secrets.token_urlsafe(24))"`.
# Separate tokens on purpose -- revoking one must not take the others down.
#
#   SCORES_FEED_TOKEN  ->  /scores/<token>.csv    applicant scores, for the sheet
#   SCOUT_FEED_TOKEN   ->  /scouted/<token>.csv   scouted leads and how to reach them
#   BOARD_TOKEN        ->  /board/<token>.html    the applicant board, rebuilt every 15m
#   OUTREACH_FEED_TOKEN -> /outreach/<token>.csv  reachable candidates and what to say
#   SEND_CONSOLE_TOKEN  -> /send/<token>.html     the send queue; the only surface that writes
#
# Unset, the route does not exist: the handler never registers a path it has no
# token for, so a missing token fails closed rather than opening the surface.
SCORES_FEED_TOKEN=
SCOUT_FEED_TOKEN=
BOARD_TOKEN=
OUTREACH_FEED_TOKEN=
SEND_CONSOLE_TOKEN=
BOARD_HTML=/home/ubuntu/talent-engine-runtime/board.html
